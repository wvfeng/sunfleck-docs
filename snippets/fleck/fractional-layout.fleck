<Window xmlns="urn:sunfleck:v1" Title="Fractional layout" Width="640" Height="420">
  <Border Background="#f5f7fc" BorderBrush="#a8b8d0" BorderThickness="0.75" Padding="24.25">
    <StackPanel Spacing="12.5" FontFamily="Segoe UI" FontSize="18">
      <TextBlock Text="Fractional margins and shared edges" FontSize="26" FontWeight="Bold"/>
      <Border BorderBrush="#476ec8" BorderThickness="0.25" Margin="0.25,0.5,0.75,1.25">
        <Border BorderBrush="#b43b58" BorderThickness="0.25">
          <TextBlock Margin="8.25,6.5" Text="Nested fractional insets accumulate before the final pixel boundary is rounded."/>
        </Border>
      </Border>
      <Grid ColumnDefinitions="*,*,*" Spacing="0" Height="36.5" MaxWidth="Infinity" Margin="0.25,0">
        <Border Background="#476ec8"/>
        <Border Grid.Column="1" Background="#b43b58"/>
        <Border Grid.Column="2" Background="#286b50"/>
      </Grid>
      <TextBlock Text="Resize the window or change DPI: all three columns keep shared edges without gaps."/>
    </StackPanel>
  </Border>
</Window>
