<Window xmlns="urn:sunfleck:v1" Title="C">
  <StackPanel Spacing="14">
    <TextBlock Text="新建空目录，准备 C11/C++ 工具链、CMake 3.25+ 与 Ninja。将 C SDK 解压到本地目录。" TextWrapping="Wrap"/>
    <StackPanel Id="c-fleck" Visibility="Visible" Spacing="14">
      <TextBlock Text="C · Fleck 页面" FontSize="20" FontWeight="SemiBold" Height="34"/>
      <TextBlock Text="添加页面和入口文件。运行时会从输出目录加载 main.fleck。" TextWrapping="Wrap"/>
      <TextArea Id="source-CMakeLists.txt" Text="cmake_minimum_required(VERSION 3.25)&#10;project(HelloSunfleck LANGUAGES C CXX)&#10;find_package(Sunfleck 1.0.0 CONFIG REQUIRED)&#10;add_executable(HelloSunfleck main.c)&#10;target_link_libraries(HelloSunfleck PRIVATE Sunfleck::sunfleck)&#10;set_property(TARGET HelloSunfleck PROPERTY LINKER_LANGUAGE CXX)&#10;configure_file(main.fleck main.fleck COPYONLY)"/>
      <TextArea Id="source-main.fleck" Text="&lt;Window xmlns=&quot;urn:sunfleck:v1&quot; Title=&quot;Hello Sunfleck&quot; Width=&quot;480&quot; Height=&quot;280&quot;&gt;&#10;  &lt;StackPanel Padding=&quot;20&quot;&gt;&#10;    &lt;TextBlock Text=&quot;Hello Sunfleck&quot;/&gt;&#10;  &lt;/StackPanel&gt;&#10;&lt;/Window&gt;"/>
      <TextArea Id="source-main.c" Text="#include &lt;sunfleck/ui.h&gt;&#10;#include &lt;stdio.h&gt;&#10;&#10;static ui_result load_page(ui_app* app)&#10;{&#10;    FILE* page = fopen(&quot;main.fleck&quot;, &quot;rb&quot;);&#10;    if (!page) { return UI_ERROR_INVALID_ARGUMENT; }&#10;    char xml[4096];&#10;    size_t size = fread(xml, 1, sizeof(xml), page);&#10;    int complete = feof(page) &amp;&amp; !ferror(page);&#10;    fclose(page);&#10;    if (!complete) { return UI_ERROR_INVALID_ARGUMENT; }&#10;    return ui_app_load_fleck(app, xml, size, NULL);&#10;}&#10;&#10;int main(void)&#10;{&#10;    const ui_app_options options = {sizeof options, UI_API_VERSION, UI_AUTO, 0};&#10;    ui_app* app = NULL;&#10;    ui_result result = ui_app_create(&amp;options, &amp;app);&#10;    if (result != UI_OK) { return 1; }&#10;    result = load_page(app);&#10;    if (result == UI_OK) { result = ui_app_open_window(app); }&#10;    if (result == UI_OK) { result = ui_app_run(app); }&#10;    ui_app_destroy(app);&#10;    return result == UI_EXITED ? 0 : 1;&#10;}"/>
      <TextBlock Text="构建并运行" FontSize="20" FontWeight="Bold"/>
      <TextArea Id="source-终端" Text="cmake -S . -B out -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_PREFIX_PATH=&quot;&lt;SDK目录&gt;&quot;&#10;cmake --build out&#10;cmake -E chdir out ./HelloSunfleck"/>
      <TextBlock Text="把 &lt;SDK目录&gt; 替换为对应语言 SDK 的解压位置，运行后会打开带有 Hello Sunfleck 的窗口。" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel Id="c-code" Visibility="Collapsed" Spacing="14">
      <TextBlock Text="C · 纯代码界面" FontSize="20" FontWeight="SemiBold" Height="34"/>
      <TextBlock Text="添加项目文件和入口代码，由宿主直接创建和配置控件。" TextWrapping="Wrap"/>
      <TextArea Id="source-CMakeLists.txt" Text="cmake_minimum_required(VERSION 3.25)&#10;project(HelloSunfleck LANGUAGES C CXX)&#10;find_package(Sunfleck 1.0.0 CONFIG REQUIRED)&#10;add_executable(HelloSunfleck main.c)&#10;target_link_libraries(HelloSunfleck PRIVATE Sunfleck::sunfleck)&#10;set_property(TARGET HelloSunfleck PROPERTY LINKER_LANGUAGE CXX)"/>
      <TextArea Id="source-main.c" Text="#include &lt;sunfleck/ui.h&gt;&#10;&#10;int main(void)&#10;{&#10;    const ui_app_options options = {sizeof options, UI_API_VERSION, UI_AUTO, 0};&#10;    ui_app* app = NULL;&#10;    ui_result result = ui_app_create(&amp;options, &amp;app);&#10;    if (result != UI_OK) { return 1; }&#10;    ui_node* text = NULL;&#10;    result = ui_node_create(app, UI_TEXT_BLOCK, &amp;text);&#10;    if (result == UI_OK) { result = ui_node_set_text(text, &quot;Hello Sunfleck&quot;); }&#10;    if (result == UI_OK) { result = ui_app_set_root(app, text); }&#10;    if (result == UI_OK) { result = ui_app_open_window(app); }&#10;    if (result == UI_OK) { result = ui_app_run(app); }&#10;    ui_app_destroy(app);&#10;    return result == UI_EXITED ? 0 : 1;&#10;}"/>
      <TextBlock Text="构建并运行" FontSize="20" FontWeight="Bold"/>
      <TextArea Id="source-终端" Text="cmake -S . -B out -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_PREFIX_PATH=&quot;&lt;SDK目录&gt;&quot;&#10;cmake --build out&#10;cmake -E chdir out ./HelloSunfleck"/>
      <TextBlock Text="把 &lt;SDK目录&gt; 替换为对应语言 SDK 的解压位置，运行后会打开带有 Hello Sunfleck 的窗口。" TextWrapping="Wrap"/>
    </StackPanel>
  </StackPanel>
</Window>
