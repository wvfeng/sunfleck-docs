<Window xmlns="urn:sunfleck:v1" Title="菜单栏">
  <StackPanel>
    <TextBlock Id="summary" Text="在顶部集中放置菜单入口。"/>
    <StackPanel Id="demo">
      <MenuBar><ComboBox Text="文件" Width="104"><ListItem Text="新建"/><ListItem Text="打开"/></ComboBox><Button Text="帮助" Width="76"/></MenuBar>
    </StackPanel>
    <StackPanel Id="guide" Spacing="10">
      <TextBlock Text="用下拉框或按钮承载菜单操作并在应用层连接命令。" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel Id="api">
      <TextBlock Id="Spacing" Text="菜单入口间距。"/>
    </StackPanel>
  </StackPanel>
</Window>
