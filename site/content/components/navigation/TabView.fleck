<Window xmlns="urn:sunfleck:v1" Title="页签">
  <StackPanel>
    <TextBlock Id="summary" Text="在同一区域内切换分组内容。"/>
    <StackPanel Id="demo">
      <TabView Value="0" Height="132"><TabItem Text="概览"><TextBlock Text="项目概览"/></TabItem><TabItem Text="设置"><TextBlock Text="项目设置"/></TabItem></TabView>
    </StackPanel>
    <StackPanel Id="guide" Spacing="10">
      <TextBlock Text="相互独立的组使用不同 TabItem。用 Value 保存或恢复选中页。" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel Id="api">
      <TextBlock Id="Value" Text="当前页签的零基索引。"/>
    </StackPanel>
  </StackPanel>
</Window>
