<Window xmlns="urn:sunfleck:v1" Title="列表">
  <StackPanel>
    <TextBlock Id="summary" Text="呈现可选择的纵向项目集合。"/>
    <StackPanel Id="demo">
      <ListView Height="112" Value="1"><ListItem Text="待处理"/><ListItem Text="进行中"/><ListItem Text="已完成"/></ListView>
    </StackPanel>
    <StackPanel Id="guide" Spacing="10">
      <TextBlock Text="静态列表用 ListItem，动态列表绑定项目集合。" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel Id="api">
      <TextBlock Id="Value" Text="选中项的零基索引。"/>
    </StackPanel>
  </StackPanel>
</Window>
