<Window xmlns="urn:sunfleck:v1" Title="切换按钮">
  <StackPanel>
    <TextBlock Id="summary" Text="在工具栏或面板中切换并显示当前选中状态。"/>
    <StackPanel Id="demo">
      <ToggleButton Text="锁定面板" Width="140" Value="1"/>
    </StackPanel>
    <StackPanel Id="guide" Spacing="10">
      <TextBlock Text="把状态绑定到应用的布尔值，界面可在再次激活时恢复。" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel Id="api">
      <TextBlock Id="Value" Text="0 未选中，1 已选中。"/>
      <TextBlock Id="Text" Text="可辨认的操作名称。"/>
    </StackPanel>
  </StackPanel>
</Window>
