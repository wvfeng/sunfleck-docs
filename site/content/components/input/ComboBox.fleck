<Window xmlns="urn:sunfleck:v1" Title="下拉框">
  <StackPanel>
    <TextBlock Id="summary" Text="在有限的选项列表中选择一项。"/>
    <StackPanel Id="demo">
      <ComboBox Width="210" Value="1"><ListItem Text="标准"/><ListItem Text="紧凑"/><ListItem Text="宽松"/></ComboBox>
    </StackPanel>
    <StackPanel Id="guide" Spacing="10">
      <TextBlock Text="使用 ListItem 声明选项，读取从 0 开始的索引。" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel Id="api">
      <TextBlock Id="Value" Text="当前选择的零基索引。"/>
    </StackPanel>
  </StackPanel>
</Window>
