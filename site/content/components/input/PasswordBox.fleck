<Window xmlns="urn:sunfleck:v1" Title="密码输入">
  <StackPanel>
    <TextBlock Id="summary" Text="以遮罩字符呈现敏感输入。"/>
    <StackPanel Id="demo">
      <PasswordBox Width="260" Height="36" Text="example"/>
    </StackPanel>
    <StackPanel Id="guide" Spacing="10">
      <TextBlock Text="避免把真实凭据放在 Fleck 源码或诊断日志中。" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel Id="api">
      <TextBlock Id="Text" Text="密码输入内容。"/>
    </StackPanel>
  </StackPanel>
</Window>
