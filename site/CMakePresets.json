{
  "version": 6,
  "configurePresets": [
    {
      "name": "vs2026-debug",
      "description": "Build the Wasm documentation site for browser debugging on Windows",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/${presetName}",
      "toolchainFile": "${sourceDir}/../../sdk/local/emsdk/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "environment": {
        "EM_CONFIG": "${sourceDir}/../../sdk/local/emsdk/.emscripten",
        "EM_CACHE": "${sourceDir}/../../sdk/local/emscripten-cache",
        "PATH": "${sourceDir}/../../sdk/local/bin;${sourceDir}/../../sdk/local/emsdk/python/3.9.2-nuget_64bit;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "Sunfleck_DIR": "${sourceDir}/../../sdk/local/web-wasm32/lib/cmake/Sunfleck",
        "SUNFLECK_FLECKC": "${sourceDir}/../../sdk/local/windows-x64/bin/fleckc.exe",
        "Python3_EXECUTABLE": "${sourceDir}/../../sdk/local/emsdk/python/3.9.2-nuget_64bit/python.exe"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vs2026-debug",
      "configurePreset": "vs2026-debug"
    }
  ]
}
